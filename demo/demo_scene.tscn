[node name="BannerHide" type="Button" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Hide Banner"

[node name="BannerDestroy" type="Button" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Destroy Banner"

[node name="InterstitialLoad" type="Button" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Load Interstitial"

[node name="InterstitialShow" type="Button" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Show Interstitial"

[node name="RewardedLoad" type="Button" parent="Margin/VBox"]
unique_name_in_owner = true
